# Production environment template.
#
# These variables must be set on Railway under:
#   Project → Service → Variables
#
# They should NEVER be in a committed .env file.

NODE_ENV=production

# Supabase Transaction pooler (for the app runtime)
# Host pattern: aws-X.pooler.supabase.com
# Port: 6543
# Get it from: Supabase → Project Settings → Database → Connection string → "Transaction"
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-X.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Direct connection (for Prisma migrations)
# Host pattern: db.PROJECTREF.supabase.co
# Port: 5432
# Get it from: Supabase → Project Settings → Database → Connection string → "Direct connection"
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres

# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=https://your-frontend-domain.com

# PORT is injected automatically by Railway — do not set it here
