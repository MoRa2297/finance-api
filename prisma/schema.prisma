// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurringType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id            Int             @id @default(autoincrement())
  email         String
  password      String?
  name          String?
  surname       String?
  birthDate     DateTime?       @db.Date
  sex           String?
  imageUrl      String?         @default("")
  acceptedTerms Boolean         @default(true)
  token         String?
  updateDate    DateTime        @default(now())
  createdDate   DateTime        @default(now())
  category      Category[]
  bankAccount   BankAccount[]
  cardAccount   CardAccount[]
  transaction   Transaction[]
  recurringRule RecurringRule[]
}

model Color {
  id          Int           @id @default(autoincrement())
  hexCode     String
  updateDate  DateTime      @default(now())
  createdDate DateTime      @default(now())
  category    Category[]
  bankAccount BankAccount[]
}

model CategoryIcon {
  id          Int        @id @default(autoincrement())
  iconName    String
  updateDate  DateTime   @default(now())
  createdDate DateTime   @default(now())
  category    Category[]
}

model BankType {
  id          Int           @id @default(autoincrement())
  name        String
  imageUrl    String        @default("")
  updateDate  DateTime      @default(now())
  createdDate DateTime      @default(now())
  bankAccount BankAccount[]
}

model BankAccountType {
  id          Int           @id @default(autoincrement())
  name        String
  updateDate  DateTime      @default(now())
  createdDate DateTime      @default(now())
  bankAccount BankAccount[]
}

model CardType {
  id          Int           @id @default(autoincrement())
  name        String
  imageUrl    String        @default("")
  updateDate  DateTime      @default(now())
  createdDate DateTime      @default(now())
  cardAccount CardAccount[]
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String
  type          CategoryType
  updateDate    DateTime        @default(now())
  createdDate   DateTime        @default(now())
  createdBy     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  categoryColor Color           @relation(fields: [colorId], references: [id])
  colorId       Int
  categoryIcon  CategoryIcon?   @relation(fields: [iconId], references: [id])
  iconId        Int?
  transaction   Transaction[]
  recurringRule RecurringRule[]
}

model BankAccount {
  id                Int              @id @default(autoincrement())
  name              String
  startingBalance   Float
  updateDate        DateTime         @default(now())
  createdDate       DateTime         @default(now())
  createdBy         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int
  color             Color?           @relation(fields: [colorId], references: [id])
  colorId           Int?
  bankType          BankType?        @relation(fields: [bankTypeId], references: [id])
  bankTypeId        Int?
  bankAccountType   BankAccountType? @relation(fields: [bankAccountTypeId], references: [id])
  bankAccountTypeId Int?
  cardAccount       CardAccount[]
  transaction       Transaction[]
  recurringRule     RecurringRule[]
  transfersFrom     TransferDetail[] @relation("TransferFrom")
  transfersTo       TransferDetail[] @relation("TransferTo")
}

model CardAccount {
  id            Int             @id @default(autoincrement())
  name          String
  cardLimit     Float
  monthExpiry   Int
  yearExpiry    Int
  updateDate    DateTime        @default(now())
  createdDate   DateTime        @default(now())
  createdBy     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  bankAccount   BankAccount?    @relation(fields: [bankAccountId], references: [id])
  bankAccountId Int?
  cardType      CardType?       @relation(fields: [cardTypeId], references: [id])
  cardTypeId    Int?
  transaction   Transaction[]
  recurringRule RecurringRule[]
}

model Transaction {
  id              Int              @id @default(autoincrement())
  money           Float
  date            DateTime         @db.Date
  description     String
  recurrent       Boolean          @default(false)
  note            String           @default("")
  type            TransactionType
  updateDate      DateTime         @default(now())
  createdDate     DateTime         @default(now())
  createdBy       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int?
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id])
  bankAccountId   Int?
  category        Category?        @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  card            CardAccount?     @relation(fields: [cardAccountId], references: [id])
  cardAccountId   Int?
  recurringRule   RecurringRule?   @relation(fields: [recurringRuleId], references: [id])
  recurringRuleId Int?
  transferFrom    TransferDetail?  @relation("TransferFrom")
  transferTo      TransferDetail?  @relation("TransferTo")
}

model TransferDetail {
  id                Int         @id @default(autoincrement())
  updateDate        DateTime    @default(now())
  createdDate       DateTime    @default(now())
  fromTransaction   Transaction @relation("TransferFrom", fields: [fromTransactionId], references: [id], onDelete: Cascade)
  fromTransactionId Int         @unique
  toTransaction     Transaction @relation("TransferTo", fields: [toTransactionId], references: [id], onDelete: Cascade)
  toTransactionId   Int         @unique
  fromAccount       BankAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  fromAccountId     Int
  toAccount         BankAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  toAccountId       Int
}

model RecurringRule {
  id                Int           @id @default(autoincrement())
  description       String
  amount            Float
  type              RecurringType
  frequency         Frequency
  startDate         DateTime      @db.Date
  endDate           DateTime?     @db.Date
  dayOfMonth        Int?
  dayOfWeek         String?
  note              String        @default("")
  isActive          Boolean       @default(true)
  lastGeneratedDate DateTime?     @db.Date
  updateDate        DateTime      @default(now())
  createdDate       DateTime      @default(now())
  createdBy         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int
  category          Category      @relation(fields: [categoryId], references: [id])
  categoryId        Int
  bankAccount       BankAccount?  @relation(fields: [bankAccountId], references: [id])
  bankAccountId     Int?
  card              CardAccount?  @relation(fields: [cardAccountId], references: [id])
  cardAccountId     Int?
  transactions      Transaction[]
}
