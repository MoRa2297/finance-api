# Local development environment template.
# Copy this file to .env.development and fill in values.
#
# Prerequisites: docker-compose up -d (starts local Postgres on port 5434)

NODE_ENV=development
PORT=3000

# Local Postgres (adjust port if your docker-compose uses a different one)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/finance
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/finance

# Any string works locally — rotate for production
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
